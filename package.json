{
  "name": "mevsim-efekti",
  "productName": "MevsimEfekti",
  "version": "1.1.3",
  "description": "Masaüstüne kar ve sonbahar yaprakları yağdıran ücretsiz uygulama",
  "main": "main.js",
  "author": "ayycha",
  "license": "MIT",
  "repository": "github:ayycha/mevsim-efekti",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ayycha.mevsimefekti",
    "productName": "MevsimEfekti",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "window-tracker.js",
      "tray.png",
      "build/icon.png",
      "!**/node_modules/koffi/build/koffi/{darwin,linux,musl,freebsd,openbsd}_*/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "${productName}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-linux.${ext}"
    }
  },
  "dependencies": {
    "koffi": "^2.9.0"
  }
}
